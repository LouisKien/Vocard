# Vocard single-guild homelab configuration.
# Copy this file to .env and fill the REQUIRED values before real use.

# Compose
COMPOSE_PROJECT_NAME=vocard
VOCARD_ENV_FILE=.env

# Discord (REQUIRED)
DISCORD_TOKEN=
SERVER_ID=

# Optional Discord personalization.
# CLIENT_ID may stay empty; the bot derives it from Discord after login.
CLIENT_ID=
BOT_NAME=Vocard
BOT_PREFIX=?
DEFAULT_LANGUAGE=VN
BOT_ACTIVITY_JSON=[{"type":"listening","name":"/help","status":"online"}]
BOT_ACCESS_USER_IDS=

# Legacy Discord aliases are accepted by the bot if you bring an older .env:
# BOT_TOKEN, TOKEN, DISCORD_GUILD_ID.

# MongoDB (REQUIRED for first deployment; change the password)
# MongoDB 4.4 is pinned because Intel N4100/non-AVX CPUs cannot run MongoDB 5+.
MONGO_IMAGE=mongo:4.4.29-focal
MONGO_INITDB_ROOT_USERNAME=vocard
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGODB_URL=mongodb://vocard:change-me@mongo:27017/?authSource=admin
MONGODB_NAME=vocard
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
MONGO_WIREDTIGER_CACHE_SIZE_GB=0.25

# Lavalink (REQUIRED; internal network only, not published to the host)
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me
LAVALINK_SECURE=false
LAVALINK_NODE_IDENTIFIER=DEFAULT
LAVALINK_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Compose-managed Spotify token helper used by LavaSrc.
SPOTIFY_TOKENER_IMAGE=ghcr.io/topi314/spotify-tokener:master@sha256:7841fa6144bd27b75b3ffc5d89c8201f833e0b9e2d3e8b4d5af8371504fd43f8

# LavaSrc Spotify (REQUIRED while LAVASRC_SPOTIFY_ENABLED=true)
LAVASRC_SPOTIFY_ENABLED=true
LAVASRC_SPOTIFY_CLIENT_ID=
LAVASRC_SPOTIFY_CLIENT_SECRET=
LAVASRC_SPOTIFY_COUNTRY_CODE=VN

# Optional but recommended for generated/editorial playlists such as 37i9dQZ*.
LAVASRC_SPOTIFY_SP_DC=
LAVASRC_SPOTIFY_CUSTOM_TOKEN_ENDPOINT=http://spotify-tokener:8080/api/token

# LavaSrc Spotify tuning.
LAVASRC_SPOTIFY_PLAYLIST_LOAD_LIMIT=6
LAVASRC_SPOTIFY_ALBUM_LOAD_LIMIT=6
LAVASRC_SPOTIFY_RESOLVE_ARTISTS_IN_SEARCH=true
LAVASRC_SPOTIFY_PREFER_PARTNER_API=true
LAVASRC_SPOTIFY_PREFER_V1_SEARCH_API=true

# Legacy LavaSrc aliases are accepted if you bring an older .env:
# SPOTIFY_ENABLED, SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET,
# SPOTIFY_COUNTRY_CODE, SPOTIFY_SP_DC, SPOTIFY_PREFER_PARTNER_API,
# SPOTIFY_PREFER_V1_SEARCH_API, SPOTIFY_CUSTOM_TOKEN_ENDPOINT.
SPOTIFY_CUSTOM_TOKEN_ENDPOINT=http://spotify-tokener:8080/api/token

# Lyrics
GENIUS_TOKEN=
LYRICS_PLATFORM=lrclib

# Visuals and queue behavior
EMBED_COLOR=0xb3b3b3
DEFAULT_MAX_QUEUE=1000
DEFAULT_SEARCH_PLATFORM=youtube
CHECK_UPSTREAM_UPDATES=false

# Logging: default to Docker stdout/stderr.
LOG_FILE_ENABLE=false
LOG_FILE_PATH=./logs
LOG_MAX_HISTORY=30
LOG_LEVEL_DISCORD=INFO
LOG_LEVEL_VOCARD=INFO
LOG_LEVEL_IPC_CLIENT=INFO

# Playlist limits
PLAYLIST_MAX_PLAYLISTS=5
PLAYLIST_MAX_TRACKS=500
DEFAULT_PLAYLIST_NAME=Favourite

# Background timers
BOT_ACTIVITY_UPDATE_SECONDS=600
INACTIVE_PLAYER_CLEANUP_SECONDS=600
CACHE_CLEANUP_SECONDS=43200

# Dashboard IPC is disabled in this homelab fork.
IPC_ENABLE=false
IPC_HOST=127.0.0.1
IPC_PORT=8000
IPC_PASSWORD=change-me
IPC_SECURE=false
